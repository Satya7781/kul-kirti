NODE_ENV=development
PORT=5500
# Local development database. Production must use verified TLS (see DATABASE_CA).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kulkirti
# PEM CA bundle for the database provider. Optional when the system trust store
# contains the CA. Literal \n sequences are accepted.
DATABASE_CA=
DATABASE_POOL_MAX=10
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-before-first-start
FRONTEND_ORIGIN=http://localhost:5500
# Optional Neon Realtime integration (leave blank to disable the endpoint).
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
